rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Lock down user profiles to only their respective owners
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Default fallback deny all unauthenticated access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
